# ================================
# PixelTool Environment Configuration
# ================================
# Copy this file to .env.local and fill in your values

# ================================
# SITE CONFIGURATION
# ================================
NEXT_PUBLIC_SITE_URL=https://pixeltool.pro
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# DATABASE CONFIGURATION
# ================================
# Postgres в Docker на проде (контейнер pixeltool-db, сеть pixeltool-net,
# без публикации порта на хост — доступен только другим контейнерам в сети).
# Для локальной разработки подними свой Postgres и укажи его сюда.
DATABASE_URL=postgresql://pixeltool:password@localhost:5432/pixeltool

# ================================
# REDIS CONFIGURATION
# ================================
# Redis URL for online users counter
# Default: redis://127.0.0.1:6379
# Docker: redis://127.0.0.1:6379 (if using docker compose)
REDIS_URL=redis://127.0.0.1:6379

# ================================
# ANALYTICS
# ================================
NEXT_PUBLIC_YANDEX_METRIKA_ID=your-metrika-id

# ================================
# SEO & VERIFICATION (Optional)
# ================================
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code

# ================================
# PRODUCTION DEPLOYMENT
# ================================
# These are set automatically by deployment platforms:
# NODE_ENV=production
# VERCEL_URL (set by Vercel)
# PORT (for self-hosted deployments)
